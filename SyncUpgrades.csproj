<Project Sdk="Microsoft.NET.Sdk">

  <!-- Project build settings -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>    <!-- Standard for modern Unity modding -->
    <Nullable>enable</Nullable>                          <!-- Enable C# nullable reference type checks -->
    <LangVersion>latest</LangVersion>                    <!-- Use latest available C# language features -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>          <!-- Allow 'unsafe' code blocks (often required for modding) -->
    <Version>2.0.7</Version>                             <!-- Your plugin version -->
  </PropertyGroup>

  <!-- Game library references -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>References\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Photon3Unity3D">
      <HintPath>References\Photon3Unity3D.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PhotonRealtime">
      <HintPath>References\PhotonRealtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PhotonUnityNetworking">
      <HintPath>References\PhotonUnityNetworking.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>References\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>References\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- NuGet dependencies -->
  <ItemGroup>
 
    <!-- BepInEx static analyzers: IDE/build warnings for common plugin issues -->
    <PackageReference Include="BepInEx.Analyzers" Version="1.0.8" PrivateAssets="all" />

    <!-- Assembly Publicizer: makes all fields/methods public in referenced DLLs -->
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />

    <!-- Core BepInEx library (runtime) -->
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />

    <!-- PluginInfoProps: allows plugin metadata (version, GUID, etc.) to be set in MSBuild -->
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" />

    <!-- HarmonyX: Modern fork of Harmony for method patching -->
    <PackageReference Include="HarmonyX" Version="2.9.0" />

    <!-- REPOLib: Zehs REPO modding library -->
    <PackageReference Include="Zehs.REPOLib" Version="2.1.0" />

  </ItemGroup>
</Project>
